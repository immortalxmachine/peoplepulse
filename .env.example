# Copy to .env and fill in. .env is git-ignored.

# --- Warehouse connection ---
# Local dev defaults to a SQLite file if DATABASE_URL is unset.
# CI / Postgres example:
#   DATABASE_URL=postgresql+psycopg://pulse_rw:pulse@localhost:5432/peoplepulse
DATABASE_URL=

# Read-only role used by the GenAI query API (guardrail: the API never uses
# the read-write URL above). On SQLite this is ignored (file is opened RO).
#   DATABASE_URL_RO=postgresql+psycopg://pulse_ro:pulse@localhost:5432/peoplepulse
DATABASE_URL_RO=

# --- GenAI HR query assistant ---
# Provider for natural-language -> SQL. One of: mock | gemini | ollama
# Default is "mock" so tests and CI need no API key.
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Only needed when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
